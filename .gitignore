# Generated pipeline output — regenerate with `python main.py`
output/*
!output/.gitkeep

# Secrets. The pipeline reads ANTHROPIC_API_KEY from the environment only;
# no key is ever written to a file in this repo.
.env
.env.*
!.env.example
*.pem
credentials.json

